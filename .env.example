# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé "service_role" — SERVEUR UNIQUEMENT, ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Administrateurs — emails (séparés par des virgules) promus automatiquement
# admin à la connexion, sans manipulation dans Supabase.
# Ex. : ADMIN_EMAILS=kevin.ido@yahoo.com,boutique@lagracededieu.ci
# Nécessite SUPABASE_SERVICE_ROLE_KEY (déjà requis ci-dessus).
ADMIN_EMAILS=

# Code d'installation admin — active la (ré)initialisation sécurisée du compte
# administrateur depuis /admin (onglet « Créer un compte » → champ « Code
# d'installation »). Choisissez une phrase secrète connue de vous seul.
# Indispensable si l'email de confirmation Supabase n'est pas délivré ou si le
# mot de passe admin est oublié. Laisser vide = fonctionnalité désactivée.
ADMIN_SETUP_SECRET=

# CinetPay (paiement Mobile Money / carte) — https://client.cinetpay.com
# Laisser vide en développement : le paiement en ligne bascule alors sur un
# message expliquant de régler à la livraison / par virement.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# WhatsApp Cloud API (notifications automatiques) — https://developers.facebook.com/docs/whatsapp/cloud-api
# Laisser vide : les liens wa.me manuels (bouton "Prévenir le client") restent fonctionnels sans elles.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Assistant IA « Grâce » — https://console.anthropic.com
# Laisser vide : le chat affiche alors un message de repli avec le numéro WhatsApp.
ANTHROPIC_API_KEY=
# Facultatif — modèle Claude à utiliser (par défaut : claude-opus-4-8)
ANTHROPIC_MODEL=
